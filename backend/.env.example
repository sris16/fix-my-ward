# Backend Environment Configuration Template

# Server Port
PORT=5000

# Node Environment (development | production | test)
NODE_ENV=production

# MongoDB Connection String (Atlas or Local)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/fixmyward?retryWrites=true&w=majority

# JWT Secret Key for Token Generation & Verification
JWT_SECRET=your_super_secret_jwt_key_change_in_production
